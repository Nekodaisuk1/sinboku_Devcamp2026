{
  "name": "shimboku-service",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run prototype:sync && wrangler dev",
    "build": "npm run prototype:sync && wrangler deploy --dry-run --outdir=dist",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm run test",
    "catalog:seed": "node scripts/build-catalog-seed.mjs",
    "prototype:sync": "npm --prefix ../wireframe run build && node scripts/sync-prototype.mjs",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@types/node": "^24.13.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "wrangler": "^4.131.1"
  }
}
